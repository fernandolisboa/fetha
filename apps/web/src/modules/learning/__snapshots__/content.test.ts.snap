      ],
      "prompt": "O valor intrínseco de uma call é:",
    },
    {
      "correctOptionId": "a",
      "explanation": "Fora do dinheiro, exercer agora não valeria nada, então o valor intrínseco é zero.",
      "options": [
        "Igual ao prêmio inteiro",
        "Zero",
        "Negativo",
      ],
      "prompt": "O valor intrínseco de uma opção fora do dinheiro é sempre:",
    },
    {
      "correctOptionId": "c",
