      "options": [
        "Trava a perda na própria queda da ação, em vez de deixá-la sem limite",
        "Remove todo risco de lançar a call",
        "Dobra o prêmio recebido",
      ],
      "prompt": "Um lançamento coberto — lançar uma call tendo a ação por trás — comparado a um a descoberto:",
    },
