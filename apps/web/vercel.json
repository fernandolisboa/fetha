{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "pnpm build",
  "ignoreCommand": "sh scripts/vercel-ignore-build.sh",
  "crons": [
    {
      "path": "/api/cron/ingest",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/cron/ingest",
      "schedule": "30 3 * * *"
    },
    {
      "path": "/api/cron/ingest",
      "schedule": "0 9 * * *"
    }
  ]
}
